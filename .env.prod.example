# Copy this file to `.env.prod` (which is gitignored) and fill in real values.
# Then bring up prod Mongo with:
#   docker compose -f infra/docker/mongo-prod.yml --env-file .env.prod up -d

# Runtime — used by gateway and bootstrap services
MONGO_URI=mongodb://CHANGEME_USER:CHANGEME_PASSWORD@127.0.0.1:27019/zeler_platform_prod?replicaSet=rs0&directConnection=true&authSource=admin
MONGO_DB=zeler_platform_prod

# Bootstrap — used ONLY for the one-time replica-set init.
# Forwarded by infra/docker/mongo-prod.yml into MONGO_INITDB_ROOT_* so the
# container's first-boot bootstrap and init_replica_set.py share one source.
# Distinct from the runtime service-user embedded in MONGO_URI above.
MONGO_ADMIN_USER=CHANGEME_ADMIN
MONGO_ADMIN_PASSWORD=CHANGEME_STRONG_PASSWORD

# Optional — only override these if the operator host topology differs from
# the default 127.0.0.1:27019 single-node loopback layout.
# MONGO_INIT_URI=mongodb://127.0.0.1:27019/?directConnection=true
# MONGO_RS_MEMBER_HOST=127.0.0.1:27019
# MONGO_INIT_TIMEOUT_S=30

# (Other prod env vars — RabbitMQ, KMS, Cloud Run — go here too if/when applicable)
