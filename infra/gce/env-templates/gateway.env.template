# gateway.env.template — Gateway API service
# Populated at boot by zeler-platform-secrets.sh from Secret Manager.

# --- BASE: shared across all app services ---
MONGO_URI=__PLACEHOLDER__
MONGO_DB=zeler_platform_prod
RABBITMQ_URL=__PLACEHOLDER__
GOOGLE_CLOUD_PROJECT=zeler-platform-dev
KMS_PROJECT_ID=zeler-platform-dev
KMS_LOCATION=us-central1
KMS_KEYRING=zeler-platform

# --- Meli OAuth credentials ---
MELI_CLIENT_ID=__PLACEHOLDER__
MELI_CLIENT_SECRET=__PLACEHOLDER__
MELI_REDIRECT_URI=https://gateway.zeler.ai/oauth/callback

# --- KMS key references ---
KMS_MELI_TOKENS_KEY=meli-tokens
KMS_PLATFORM_JWT_KEY=platform-jwt

# --- Gateway proxy policy ---
GATEWAY_PROXY_RATE_LIMIT=600

# --- Meli webhook HMAC policy ---
# Meli does not currently sign webhooks, so validation is explicitly disabled by default.
# Future migration: set MELI_WEBHOOK_HMAC_SECRET to the Meli signing secret,
# set MELI_WEBHOOK_REQUIRE_SIGNATURE=true, then redeploy the gateway.
MELI_WEBHOOK_HMAC_SECRET=
MELI_WEBHOOK_REQUIRE_SIGNATURE=false
