# publicador-api.env.template — Publicador API service
# Populated at boot by zeler-platform-secrets.sh from Secret Manager.

# --- BASE: shared across all app services ---
MONGO_URI=__PLACEHOLDER__
MONGO_DB=zeler_platform_prod
RABBITMQ_URL=__PLACEHOLDER__
GOOGLE_CLOUD_PROJECT=zeler-platform-dev
KMS_PROJECT_ID=zeler-platform-dev
KMS_LOCATION=us-central1
KMS_KEYRING=zeler-platform

# --- Gateway proxy endpoint ---
GATEWAY_BASE_URL=http://gateway:8080
OTEL_METRICS_ENABLED=true

# --- Publicador AI (fail-closed contract) ---
# LISTING_LLM is the only AI provider selector. Legal values: "stub" or "disabled".
# Any other value fails startup with PublicadorConfigError; with stub/disabled,
# /publicador/ai/generate always returns 503 {"code":"llm_not_configured"}.
LISTING_LLM=stub
