# sheets-worker.env.template — Sheets Worker service
# Populated at boot by zeler-platform-secrets.sh from Secret Manager.

# --- BASE: shared across all app services ---
MONGO_URI=__PLACEHOLDER__
MONGO_DB=zeler_platform_prod
RABBITMQ_URL=__PLACEHOLDER__
# RabbitMQ HTTP Management endpoint for preflight topology validation only.
RABBITMQ_MANAGEMENT_URL=__PLACEHOLDER__
GOOGLE_CLOUD_PROJECT=zeler-platform-dev
KMS_PROJECT_ID=zeler-platform-dev
KMS_LOCATION=us-central1
KMS_KEYRING=zeler-platform

# --- Google OAuth credentials (sheets worker needs to refresh/read tokens) ---
GOOGLE_OAUTH_CLIENT_ID=__PLACEHOLDER__
GOOGLE_OAUTH_CLIENT_SECRET=__PLACEHOLDER__
GOOGLE_OAUTH_REDIRECT_URI=https://sheets.zeler.ai/oauth/google/callback

# --- KMS key for encrypted Google token storage ---
KMS_GOOGLE_TOKENS_KEY=google-tokens

# --- Gateway proxy endpoint ---
GATEWAY_BASE_URL=http://gateway:8080/proxy/meli
# --- Preflight-only service roots (never used for MercadoLibre proxy calls) ---
GATEWAY_URL=http://gateway:8080
SHEETS_URL=http://sheets-api:8080
WORKER_HEALTH_PORT=8080

# --- ZelerData formula freshness/enrichment flags ---
ZELERDATA_ENRICHMENT_ENABLED=true
ZELERDATA_SALE_PRICE_ENABLED=true
ZELERDATA_LISTING_FIXED_FEE_ENABLED=true
