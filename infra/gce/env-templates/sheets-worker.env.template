# sheets-worker.env.template — Sheets Worker service
# Populated at boot by zeler-platform-secrets.sh from Secret Manager.

# --- BASE: shared across all app services ---
MONGO_URI=__PLACEHOLDER__
MONGO_DB=zeler_platform_prod
RABBITMQ_URL=__PLACEHOLDER__
# RabbitMQ HTTP Management endpoint for preflight topology validation only.
RABBITMQ_MANAGEMENT_URL=__PLACEHOLDER__
GOOGLE_CLOUD_PROJECT=zeler-platform-dev
KMS_PROJECT_ID=zeler-platform-dev
KMS_LOCATION=us-central1
KMS_KEYRING=zeler-platform

# --- Google OAuth credentials (sheets worker needs to refresh/read tokens) ---
GOOGLE_OAUTH_CLIENT_ID=__PLACEHOLDER__
GOOGLE_OAUTH_CLIENT_SECRET=__PLACEHOLDER__
GOOGLE_OAUTH_REDIRECT_URI=https://sheets.zeler.ai/oauth/google/callback

# --- KMS key for encrypted Google token storage ---
KMS_GOOGLE_TOKENS_KEY=google-tokens

# --- Gateway proxy endpoint ---
GATEWAY_BASE_URL=http://gateway:8080/proxy/meli
# --- Preflight-only service roots (never used for MercadoLibre proxy calls) ---
GATEWAY_URL=http://gateway:8080
SHEETS_URL=http://sheets-api:8080
WORKER_HEALTH_PORT=8080

# --- ZelerData formula freshness/enrichment flags ---
SHEETS_SYNC_JOBS_POLLER_ENABLED=true
ZELERDATA_ENRICHMENT_ENABLED=true
ZELERDATA_SALE_PRICE_ENABLED=true
ZELERDATA_LISTING_FIXED_FEE_ENABLED=true

# --- ZelerData scheduled refresh (kill switch: set ENABLED=false) ---
# Refresh only plans recovery work; the recovery worker performs acquisition.
ZELERDATA_REFRESH_ENABLED=false
ZELERDATA_REFRESH_SELLERS=82453304
ZELERDATA_REFRESH_INTERVAL_SECONDS=900
# Reserve part of the gateway's 600 req/min per-seller budget for acquisition.
ZELERDATA_RECOVERY_REQUESTS_PER_MINUTE=180
# Devoluciones trigger now lives in the refresh loop (kill switch). It only
# advances a run an operator already authorized; it never creates one.
ZELERDATA_DEVOLUCIONES_ADVANCE_ENABLED=false
# Precalculate the heavy aggregate formulas during the refresh cycle so the
# Sheets call is a bounded document read instead of a 20s+ aggregation. When
# off (or when a result expired) the formula falls back to the on-demand path.
ZELERDATA_PRECALCULATED_FORMULAS_ENABLED=false
# Operator e-mail alerts when a read model stops refreshing or the loop keeps
# failing (Q21-a). The destination channel lives in Google Cloud Monitoring.
ZELERDATA_FRESHNESS_ALERTS_ENABLED=false
# Keep the Sheets DLQ from refilling invisibly (Q4-b/Q11-c). Each refresh
# cycle runs one bounded archive pass: only messages whose window a reconciled
# marker already covers, or that are past retention, are removed with a
# recorded reason; everything else is requeued untouched.
ZELERDATA_DLQ_ARCHIVE_ENABLED=false

# --- ZelerData formula recovery + pilot history backfill ---
# Formula recovery is required for history backfill; the recovery worker
# performs acquisition (the refresh supervisor only plans work). The operator
# must also set ZELERDATA_REFRESH_ENABLED=true to activate the backfill callback
# through the refresh supervisor's bounded loop.
ZELERDATA_FORMULA_RECOVERY_ENABLED=true
ZELERDATA_FORMULA_RECOVERY_SELLERS=82453304
