{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["_id", "email", "name", "auth_provider", "created_at", "updated_at"],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "email": {
        "bsonType": "string"
      },
      "name": {
        "bsonType": "string"
      },
      "auth_provider": {
        "enum": ["local", "google", "meli", "internal"]
      },
      "created_at": {
        "bsonType": "date"
      },
      "updated_at": {
        "bsonType": "date"
      },
      "meli_account_ids": {
        "bsonType": "array",
        "items": {
          "bsonType": "long"
        }
      },
      "roles": {
        "bsonType": "array",
        "items": {
          "bsonType": "string"
        }
      },
      "status": {
        "enum": ["active", "suspended", "deleted"]
      }
    }
  }
}
