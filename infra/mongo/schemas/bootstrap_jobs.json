{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": [
          "objectId",
          "string"
        ]
      },
      "attempt_count": {
        "bsonType": "int",
        "minimum": 0
      },
      "checkpoints": {
        "bsonType": "object"
      },
      "created_at": {
        "bsonType": "date"
      },
      "current_stage": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "dag": {
        "bsonType": "object"
      },
      "error": {
        "bsonType": [
          "string",
          "null"
        ]
      },
      "errors": {
        "bsonType": "array"
      },
      "finished_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "failed_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "last_error": {
        "bsonType": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "schema_version": {
        "bsonType": "int"
      },
      "seller_id": {
        "bsonType": [
          "string",
          "long",
          "int"
        ]
      },
      "stage_progress": {
        "bsonType": "object"
      },
      "started_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "state": {
        "enum": [
          "pending",
          "running",
          "paused",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "updated_at": {
        "bsonType": "date"
      }
    },
    "required": [
      "_id",
      "seller_id",
      "state",
      "dag",
      "checkpoints",
      "created_at",
      "updated_at",
      "schema_version"
    ]
  },
  "validationAction": "error",
  "validationLevel": "strict"
}
