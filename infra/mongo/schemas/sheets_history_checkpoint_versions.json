{
  "$jsonSchema": {
    "additionalProperties": false,
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "acquisition_id": {
        "bsonType": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "archived_at": {
        "bsonType": "date"
      },
      "checkpoint_revision": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "execution_id": {
        "bsonType": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "generation": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "head_bson": {
        "bsonType": "binData"
      },
      "head_sha256": {
        "bsonType": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "job_bson": {
        "bsonType": "binData"
      },
      "job_id": {
        "bsonType": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "job_sha256": {
        "bsonType": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "pass_number": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "reason": {
        "bsonType": "string",
        "enum": [
          "expired_question_cursor"
        ]
      },
      "seller_id": {
        "bsonType": "string",
        "pattern": "^[0-9]+$"
      }
    },
    "required": [
      "_id",
      "acquisition_id",
      "job_id",
      "seller_id",
      "execution_id",
      "generation",
      "pass_number",
      "checkpoint_revision",
      "reason",
      "archived_at",
      "head_bson",
      "job_bson",
      "head_sha256",
      "job_sha256"
    ]
  },
  "validationAction": "error",
  "validationLevel": "strict"
}
