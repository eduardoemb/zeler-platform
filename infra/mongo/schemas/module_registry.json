          "string"
        ]
      },
      "allowed_meli_scopes": {
        "bsonType": "array"
      },
      "allowed_seller_ids": {
        "bsonType": "array",
        "items": {
          "bsonType": [
            "int",
            "long",
            "string"
          ]
        }
      },
      "health": {
        "bsonType": [
          "object",
          "null"
        ]
      },
      "last_heartbeat_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "routing_keys": {
        "bsonType": "array"
      },
      "schema_version": {
        "bsonType": "int"
      },
      "status": {
        "enum": [
          "enabled",
          "disabled",
          "degraded"
        ]
      },
      "version": {
        "bsonType": "string"
      }
    },
    "required": [
      "_id",
      "version",
      "allowed_meli_scopes",
      "routing_keys",
      "status",
      "schema_version"
