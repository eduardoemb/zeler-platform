{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": [
          "objectId",
          "string"
        ]
      },
      "allowed_meli_scopes": {
        "bsonType": "array"
      },
      "allowed_seller_ids": {
        "bsonType": "array",
        "items": {
          "bsonType": [
            "int",
            "long",
            "string"
          ]
        }
      },
      "display_identity": {
        "bsonType": "object",
        "properties": {
          "availability": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "display_name": {
            "bsonType": "string"
          },
          "legacy_display_name": {
            "bsonType": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "display_name",
          "availability"
        ]
      },
      "health": {
        "bsonType": [
          "object",
          "null"
        ]
      },
      "last_heartbeat_at": {
        "bsonType": [
          "date",
          "null"
        ]
      },
      "routing_keys": {
        "bsonType": "array"
      },
      "schema_version": {
        "bsonType": "int"
      },
      "status": {
        "enum": [
          "enabled",
          "disabled",
          "degraded"
        ]
      },
      "version": {
        "bsonType": "string"
      }
    },
    "required": [
      "_id",
      "version",
      "allowed_meli_scopes",
      "routing_keys",
      "status",
      "schema_version"
    ]
  },
  "validationAction": "error",
  "validationLevel": "strict"
}
