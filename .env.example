# MongoDB (dev: local Docker; prod: on-prem with TLS)
# Set MONGO_HOST_PORT if 27017 is taken by another Mongo instance (e.g. legacy zeler-core).
MONGO_HOST_PORT=27017
MONGO_ROOT_USER=changeme_local_only
MONGO_ROOT_PASSWORD=changeme_local_only
MONGO_URI=mongodb://changeme_local_only:changeme_local_only@127.0.0.1:27017/zeler_platform_dev?authSource=admin

# CloudAMQP (Little Lemur for dev — get from cloudamqp.com dashboard)
AMQP_URL=amqps://user:pass@host/vhost

# Meli OAuth app credentials
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:8000/oauth/callback

# Token encryption (dev: local AES key as fallback; prod: GCP KMS)
TOKEN_ENCRYPTION_BACKEND=local  # or "kms"
TOKEN_LOCAL_AES_KEY=  # base64-encoded 32 bytes for dev mode

# GCP (for KMS + Secret Manager in prod)
GCP_PROJECT_ID=
GCP_KMS_KEY_NAME=

# Internal JWT signing
INTERNAL_JWT_ISSUER=zeler-platform
INTERNAL_JWT_AUDIENCE=zeler-meli-gateway
