FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY core ./core
COPY modules/autoreply ./modules/autoreply

RUN uv sync --frozen --package zeler-autoreply --no-dev

RUN useradd --system --create-home --uid 1001 appuser
USER appuser

CMD ["sh", "-c", "uv run python -m zeler_autoreply"]
