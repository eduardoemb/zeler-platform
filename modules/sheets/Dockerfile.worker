FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY core ./core
COPY infra/operations ./infra/operations
COPY infra/rabbitmq ./infra/rabbitmq
COPY modules/sheets ./modules/sheets

RUN uv sync --frozen --package zeler-sheets --no-dev

RUN test -x .venv/bin/python
RUN .venv/bin/python -c "import motor.motor_asyncio; import infra.operations.zelerdata_read_model_reconcile"
RUN .venv/bin/python -c "import infra.operations.sheets_dlq_snapshot_runtime"
RUN .venv/bin/python -c "import infra.rabbitmq.sheets_devoluciones_topology"

RUN useradd --system --create-home --uid 1001 appuser
RUN chown -R appuser:appuser /app
USER appuser

CMD ["sh", "-c", ".venv/bin/python -m zeler_sheets"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD python -c "import os,sys,urllib.request; port=os.environ.get('WORKER_HEALTH_PORT','8080'); sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=5).status == 200 else 1)"
